{
  "name": "code-scenario-vscode",
  "displayName": "Code Scenario",
  "description": "Organize and navigate code by scenarios with a sidebar tree view",
  "publisher": "takahc",
  "repository": {
    "type": "git",
    "url": "https://github.com/takahc/code-scenario-vscode"
  },
  "version": "0.1.0",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Other"],
  "activationEvents": ["onStartupFinished"],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "code-scenario",
          "title": "Code Scenario",
          "icon": "resources/scenario.svg"
        }
      ]
    },
    "views": {
      "code-scenario": [
        {
          "id": "codeScenarioView",
          "name": "Scenarios"
        }
      ]
    },
    "commands": [
      { "command": "code-scenario.addScenario", "title": "Add Scenario", "icon": "$(add)" },
      { "command": "code-scenario.deleteScenario", "title": "Delete Scenario", "icon": "$(trash)" },
      { "command": "code-scenario.renameScenario", "title": "Rename Scenario", "icon": "$(edit)" },
      { "command": "code-scenario.duplicateScenario", "title": "Duplicate Scenario", "icon": "$(copy)" },
      { "command": "code-scenario.editScenarioNote", "title": "Edit Scenario Note..." },
      { "command": "code-scenario.resetScenarioVisitedState", "title": "Reset Visited State", "icon": "$(discard)" },
      { "command": "code-scenario.markAllScenarioItemsRead", "title": "Mark All as Read", "icon": "$(pass-filled)" },
      { "command": "code-scenario.addItem", "title": "Add Item", "icon": "$(add)" },
      { "command": "code-scenario.addChildItem", "title": "Add Child Item", "icon": "$(add)" },
      { "command": "code-scenario.addItemBelow", "title": "Add Item Below", "icon": "$(arrow-down)" },
      { "command": "code-scenario.quickAddCurrentFile", "title": "Quick Add Current File to Scenario" },
      { "command": "code-scenario.quickAddSelectionSymbol", "title": "Quick Add Selected Symbol to Scenario" },
      { "command": "code-scenario.setQuickAddScenario", "title": "Set Quick Add Scenario", "icon": "$(target)" },
      { "command": "code-scenario.clearQuickAddScenario", "title": "Clear Quick Add Scenario", "icon": "$(close)" },
      { "command": "code-scenario.manageQuickAddScenario", "title": "Manage Quick Add Target" },
      { "command": "code-scenario.openItem", "title": "Open Item", "icon": "$(go-to-file)" },
      { "command": "code-scenario.markItemRead", "title": "Mark as Read", "icon": "$(pass)" },
      { "command": "code-scenario.markItemUnread", "title": "Mark as Unread", "icon": "$(circle-large-outline)" },
      { "command": "code-scenario.markBranchRead", "title": "Mark Branch as Read", "icon": "$(pass-filled)" },
      { "command": "code-scenario.markBranchUnread", "title": "Mark Branch as Unread", "icon": "$(circle-large-outline)" },
      { "command": "code-scenario.renameItem", "title": "Rename Item" },
      { "command": "code-scenario.moveItem", "title": "Move Item..." },
      { "command": "code-scenario.copyItem", "title": "Copy Item..." },
      { "command": "code-scenario.editItem", "title": "Edit Item", "icon": "$(edit)" },
      { "command": "code-scenario.quickEditItemNote", "title": "Edit Note..." },
      { "command": "code-scenario.relinkItem", "title": "Relink Item", "icon": "$(link)" },
      { "command": "code-scenario.repairStaleItem", "title": "Repair Stale Item...", "icon": "$(warning)" },
      { "command": "code-scenario.deleteItem", "title": "Delete Item", "icon": "$(trash)" },
      { "command": "code-scenario.refresh", "title": "Refresh", "icon": "$(refresh)" },
      { "command": "code-scenario.findScenarioItem", "title": "Find Scenario Item...", "icon": "$(search)" },
      { "command": "code-scenario.revealActiveFileInTree", "title": "Reveal Active File in Scenarios", "icon": "$(eye)" },
      { "command": "code-scenario.addFileFromExplorer", "title": "Add to Scenario..." },
      { "command": "code-scenario.nextItem", "title": "Next Scenario Item" },
      { "command": "code-scenario.previousItem", "title": "Previous Scenario Item" },
      { "command": "code-scenario.nextUnreadItem", "title": "Next Unread Scenario Item" },
      { "command": "code-scenario.previousUnreadItem", "title": "Previous Unread Scenario Item" },
      { "command": "code-scenario.startWalkthroughHere", "title": "Start Walkthrough Here", "icon": "$(play)" },
      { "command": "code-scenario.resumeFromFirstUnread", "title": "Resume from First Unread Item" },
      { "command": "code-scenario.enableUnreadFocusMode", "title": "Enable Unread Focus Mode", "icon": "$(filter)" },
      { "command": "code-scenario.disableUnreadFocusMode", "title": "Disable Unread Focus Mode", "icon": "$(close)" }
    ],
    "keybindings": [
      {
        "command": "code-scenario.quickAddCurrentFile",
        "key": "ctrl+shift+alt+a",
        "when": "editorTextFocus"
      },
      {
        "command": "code-scenario.quickAddSelectionSymbol",
        "key": "ctrl+shift+alt+s",
        "when": "editorTextFocus && editorHasSelection"
      },
      {
        "command": "code-scenario.addScenario",
        "key": "ctrl+shift+alt+n",
        "when": "focusedView == codeScenarioView"
      },
      {
        "command": "code-scenario.findScenarioItem",
        "key": "ctrl+shift+alt+f"
      },
      {
        "command": "code-scenario.revealActiveFileInTree",
        "key": "ctrl+shift+alt+e",
        "when": "editorTextFocus"
      },
      {
        "command": "code-scenario.nextItem",
        "key": "ctrl+shift+alt+]"
      },
      {
        "command": "code-scenario.previousItem",
        "key": "ctrl+shift+alt+["
      },
      {
        "command": "code-scenario.nextUnreadItem",
        "key": "ctrl+shift+alt+."
      },
      {
        "command": "code-scenario.previousUnreadItem",
        "key": "ctrl+shift+alt+,"
      }
    ],
    "configuration": {
      "title": "Code Scenario",
      "properties": {
        "codeScenario.autoRevealInTree": {
          "type": "boolean",
          "default": false,
          "description": "Automatically reveal the first matching scenario item in the tree when the active editor changes. Reveal is debounced and does not steal focus or show a notification when no item matches."
        }
      }
    },
    "menus": {
      "view/title": [
        {
          "command": "code-scenario.addScenario",
          "when": "view == codeScenarioView",
          "group": "navigation"
        },
        {
          "command": "code-scenario.addItem",
          "when": "view == codeScenarioView",
          "group": "navigation"
        },
        {
          "command": "code-scenario.refresh",
          "when": "view == codeScenarioView",
          "group": "navigation"
        },
        {
          "command": "code-scenario.findScenarioItem",
          "when": "view == codeScenarioView",
          "group": "navigation"
        },
        {
          "command": "code-scenario.repairStaleItem",
          "when": "view == codeScenarioView",
          "group": "navigation"
        },
        {
          "command": "code-scenario.revealActiveFileInTree",
          "when": "view == codeScenarioView",
          "group": "navigation"
        },
        {
          "command": "code-scenario.enableUnreadFocusMode",
          "when": "view == codeScenarioView && !codeScenario.unreadFocusModeEnabled",
          "group": "navigation"
        },
        {
          "command": "code-scenario.disableUnreadFocusMode",
          "when": "view == codeScenarioView && codeScenario.unreadFocusModeEnabled",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "code-scenario.renameScenario",
          "when": "view == codeScenarioView && (viewItem == scenario || viewItem == scenarioQuickAdd)",
          "group": "inline"
        },
        {
          "command": "code-scenario.deleteScenario",
          "when": "view == codeScenarioView && (viewItem == scenario || viewItem == scenarioQuickAdd)",
          "group": "inline"
        },
        {
          "command": "code-scenario.renameScenario",
          "when": "view == codeScenarioView && (viewItem == scenario || viewItem == scenarioQuickAdd)",
          "group": "1_modify"
        },
        {
          "command": "code-scenario.editScenarioNote",
          "when": "view == codeScenarioView && (viewItem == scenario || viewItem == scenarioQuickAdd)",
          "group": "1_modify"
        },
        {
          "command": "code-scenario.deleteScenario",
          "when": "view == codeScenarioView && (viewItem == scenario || viewItem == scenarioQuickAdd)",
          "group": "1_modify"
        },
        {
          "command": "code-scenario.duplicateScenario",
          "when": "view == codeScenarioView && (viewItem == scenario || viewItem == scenarioQuickAdd)",
          "group": "1_modify"
        },
        {
          "command": "code-scenario.setQuickAddScenario",
          "when": "view == codeScenarioView && viewItem == scenario",
          "group": "inline"
        },
        {
          "command": "code-scenario.clearQuickAddScenario",
          "when": "view == codeScenarioView && viewItem == scenarioQuickAdd",
          "group": "inline"
        },
        {
          "command": "code-scenario.startWalkthroughHere",
          "when": "view == codeScenarioView && (viewItem == scenario || viewItem == scenarioQuickAdd)",
          "group": "inline"
        },
        {
          "command": "code-scenario.setQuickAddScenario",
          "when": "view == codeScenarioView && viewItem == scenario",
          "group": "2_quickAdd"
        },
        {
          "command": "code-scenario.clearQuickAddScenario",
          "when": "view == codeScenarioView && viewItem == scenarioQuickAdd",
          "group": "2_quickAdd"
        },
        {
          "command": "code-scenario.startWalkthroughHere",
          "when": "view == codeScenarioView && (viewItem == scenario || viewItem == scenarioQuickAdd)",
          "group": "3_walkthrough"
        },
        {
          "command": "code-scenario.resumeFromFirstUnread",
          "when": "view == codeScenarioView && (viewItem == scenario || viewItem == scenarioQuickAdd)",
          "group": "3_walkthrough"
        },
        {
          "command": "code-scenario.resetScenarioVisitedState",
          "when": "view == codeScenarioView && (viewItem == scenario || viewItem == scenarioQuickAdd)",
          "group": "4_progress"
        },
        {
          "command": "code-scenario.markAllScenarioItemsRead",
          "when": "view == codeScenarioView && (viewItem == scenario || viewItem == scenarioQuickAdd)",
          "group": "4_progress"
        },
        {
          "command": "code-scenario.editItem",
          "when": "view == codeScenarioView && (viewItem == scenarioItemUnread || viewItem == scenarioItemRead || viewItem == scenarioItemStaleUnread || viewItem == scenarioItemStaleRead)",
          "group": "inline"
        },
        {
          "command": "code-scenario.deleteItem",
          "when": "view == codeScenarioView && (viewItem == scenarioItemUnread || viewItem == scenarioItemRead || viewItem == scenarioItemStaleUnread || viewItem == scenarioItemStaleRead)",
          "group": "inline"
        },
        {
          "command": "code-scenario.addItem",
          "when": "view == codeScenarioView && (viewItem == scenario || viewItem == scenarioQuickAdd)",
          "group": "inline"
        },
        {
          "command": "code-scenario.addChildItem",
          "when": "view == codeScenarioView && (viewItem == scenarioItemUnread || viewItem == scenarioItemRead || viewItem == scenarioItemStaleUnread || viewItem == scenarioItemStaleRead)",
          "group": "inline"
        },
        {
          "command": "code-scenario.addItemBelow",
          "when": "view == codeScenarioView && (viewItem == scenarioItemUnread || viewItem == scenarioItemRead || viewItem == scenarioItemStaleUnread || viewItem == scenarioItemStaleRead)",
          "group": "inline"
        },
        {
          "command": "code-scenario.openItem",
          "when": "view == codeScenarioView && (viewItem == scenarioItemUnread || viewItem == scenarioItemRead || viewItem == scenarioItemStaleUnread || viewItem == scenarioItemStaleRead)",
          "group": "inline"
        },
        {
          "command": "code-scenario.relinkItem",
          "when": "view == codeScenarioView && (viewItem == scenarioItemStaleUnread || viewItem == scenarioItemStaleRead)",
          "group": "inline"
        },
        {
          "command": "code-scenario.renameItem",
          "when": "view == codeScenarioView && (viewItem == scenarioItemUnread || viewItem == scenarioItemRead || viewItem == scenarioItemStaleUnread || viewItem == scenarioItemStaleRead)",
          "group": "1_modify"
        },
        {
          "command": "code-scenario.editItem",
          "when": "view == codeScenarioView && (viewItem == scenarioItemUnread || viewItem == scenarioItemRead || viewItem == scenarioItemStaleUnread || viewItem == scenarioItemStaleRead)",
          "group": "1_modify"
        },
        {
          "command": "code-scenario.quickEditItemNote",
          "when": "view == codeScenarioView && (viewItem == scenarioItemUnread || viewItem == scenarioItemRead || viewItem == scenarioItemStaleUnread || viewItem == scenarioItemStaleRead)",
          "group": "1_modify"
        },
        {
          "command": "code-scenario.addChildItem",
          "when": "view == codeScenarioView && (viewItem == scenarioItemUnread || viewItem == scenarioItemRead || viewItem == scenarioItemStaleUnread || viewItem == scenarioItemStaleRead)",
          "group": "2_add"
        },
        {
          "command": "code-scenario.addItemBelow",
          "when": "view == codeScenarioView && (viewItem == scenarioItemUnread || viewItem == scenarioItemRead || viewItem == scenarioItemStaleUnread || viewItem == scenarioItemStaleRead)",
          "group": "2_add"
        },
        {
          "command": "code-scenario.markItemRead",
          "when": "view == codeScenarioView && (viewItem == scenarioItemUnread || viewItem == scenarioItemStaleUnread)",
          "group": "3_progress"
        },
        {
          "command": "code-scenario.markItemUnread",
          "when": "view == codeScenarioView && (viewItem == scenarioItemRead || viewItem == scenarioItemStaleRead)",
          "group": "3_progress"
        },
        {
          "command": "code-scenario.markBranchRead",
          "when": "view == codeScenarioView && (viewItem == scenarioItemUnread || viewItem == scenarioItemRead || viewItem == scenarioItemStaleUnread || viewItem == scenarioItemStaleRead)",
          "group": "3_progress"
        },
        {
          "command": "code-scenario.markBranchUnread",
          "when": "view == codeScenarioView && (viewItem == scenarioItemUnread || viewItem == scenarioItemRead || viewItem == scenarioItemStaleUnread || viewItem == scenarioItemStaleRead)",
          "group": "3_progress"
        },
        {
          "command": "code-scenario.moveItem",
          "when": "view == codeScenarioView && (viewItem == scenarioItemUnread || viewItem == scenarioItemRead || viewItem == scenarioItemStaleUnread || viewItem == scenarioItemStaleRead)",
          "group": "4_modify"
        },
        {
          "command": "code-scenario.copyItem",
          "when": "view == codeScenarioView && (viewItem == scenarioItemUnread || viewItem == scenarioItemRead || viewItem == scenarioItemStaleUnread || viewItem == scenarioItemStaleRead)",
          "group": "4_modify"
        },
        {
          "command": "code-scenario.deleteItem",
          "when": "view == codeScenarioView && (viewItem == scenarioItemUnread || viewItem == scenarioItemRead || viewItem == scenarioItemStaleUnread || viewItem == scenarioItemStaleRead)",
          "group": "4_modify"
        }
      ],
      "editor/context": [
        {
          "command": "code-scenario.quickAddCurrentFile",
          "when": "editorTextFocus",
          "group": "navigation"
        },
        {
          "command": "code-scenario.quickAddSelectionSymbol",
          "when": "editorTextFocus && editorHasSelection",
          "group": "navigation"
        }
      ],
      "explorer/context": [
       {
         "command": "code-scenario.addFileFromExplorer",
         "when": "!explorerResourceIsFolder && resourceScheme == 'file'",
          "group": "2_workspace"
       }
      ],
      "commandPalette": [
        {
          "command": "code-scenario.addFileFromExplorer",
          "when": "false"
        },
        {
          "command": "code-scenario.openItem",
          "when": "false"
        },
        {
          "command": "code-scenario.markItemRead",
          "when": "false"
        },
        {
          "command": "code-scenario.markItemUnread",
          "when": "false"
        },
        {
          "command": "code-scenario.markBranchRead",
          "when": "false"
        },
        {
          "command": "code-scenario.markBranchUnread",
          "when": "false"
        },
        {
          "command": "code-scenario.moveItem",
          "when": "false"
        },
        {
          "command": "code-scenario.addChildItem",
          "when": "false"
        },
        {
          "command": "code-scenario.addItemBelow",
          "when": "false"
        },
        {
          "command": "code-scenario.copyItem",
          "when": "false"
        },
        {
          "command": "code-scenario.relinkItem",
          "when": "false"
        },
        {
          "command": "code-scenario.quickEditItemNote",
          "when": "false"
        },
        {
          "command": "code-scenario.startWalkthroughHere",
          "when": "false"
        },
        {
          "command": "code-scenario.enableUnreadFocusMode",
          "when": "!codeScenario.unreadFocusModeEnabled"
        },
        {
          "command": "code-scenario.disableUnreadFocusMode",
          "when": "codeScenario.unreadFocusModeEnabled"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "typescript": "^5.3.0"
  }
}
